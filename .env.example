PORT=3000
STATE_FILE=./data/state.json
TRADES_FILE=./data/trades.jsonl
STARTING_SOL=4
POLL_INTERVAL_MS=60000

# ---- Live trading (OFF by default). Never commit real values. ----
# LIVE_TRADING=false
# WALLET_PRIVATE_KEY=            # base58 secret key (Solflare/Phantom export). Set only in Railway secrets.
# KILL_TOKEN=                    # >= 16 chars; required for POST /api/kill and for live mode
# KILL_SWITCH=false
# LIVE_STRATEGIES=               # comma-separated strategy ids allowed to trade live
# MAX_SOL_PER_TRADE=0.05
# MAX_DAILY_LOSS_SOL=0.2
# MAX_OPEN_POSITIONS=2
# MAX_CONSECUTIVE_LOSSES=4
# PRIORITY_FEE=100000            # lamports (cap), used when JITO_TIP=0
# JITO_TIP=0                     # lamports; >0 uses a Jito tip instead of the priority fee
# MIN_WALLET_RESERVE_SOL=0.05
# LIVE_SLIPPAGE_BPS=300
# RPC_URL=https://api.mainnet-beta.solana.com
