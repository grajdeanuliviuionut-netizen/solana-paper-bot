PORT=3000
STATE_FILE=./data/state.json
TRADES_FILE=./data/trades.jsonl
STARTING_SOL=4
POLL_INTERVAL_MS=60000

# ---- Live trading (OFF by default). Never commit real values. ----
# Required to go live (no defaults):
# LIVE_TRADING=true              # anything else = paper
# WALLET_PRIVATE_KEY=            # base58 secret key (Solflare/Phantom export) or 64-number JSON array. Railway secret only.
# KILL_TOKEN=                    # random string >= 16 chars; required for live mode and POST /api/kill
# Optional (code defaults shown):
# LIVE_STRATEGIES=momentum-entry # comma-separated strategy ids allowed to trade live
# MAX_SOL_PER_TRADE=0.1          # hard cap 1
# MAX_DAILY_LOSS_SOL=0.5
# MAX_OPEN_POSITIONS=3
# MAX_CONSECUTIVE_LOSSES=5
# PRIORITY_FEE=100000            # lamports cap, used when JITO_TIP=0
# JITO_TIP=0                     # lamports; >0 uses a Jito tip instead of the priority fee
# MIN_WALLET_RESERVE_SOL=0.05
# LIVE_SLIPPAGE_BPS=300
# LIVE_MAX_SWAP_ATTEMPTS=3
# RPC_URL=https://api.mainnet-beta.solana.com   # a private RPC is recommended
# KILL_SWITCH=false              # true blocks all new live entries
